{
    "name": "ichinya/laratesto-rector",
    "description": "Rector rules to migrate Laravel PHPUnit test suites to Laratesto.",
    "license": "BSD-3-Clause",
    "type": "library",
    "keywords": [
        "testo",
        "laravel",
        "phpunit",
        "migration",
        "rector"
    ],
    "authors": [
        {
            "name": "Ichi",
            "homepage": "https://github.com/ichinya"
        }
    ],
    "require": {
        "php": "^8.3",
        "rector/rector": "2.6.2",
        "testo/bridge-rector": "^0.2.4"
    },
    "suggest": {
        "ichinya/laratesto": "Laratesto runtime API targeted by these rules (^0.6.9)"
    },
    "autoload": {
        "psr-4": {
            "Laratesto\\Rector\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
