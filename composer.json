{
    "name": "ichinya/laratesto",
    "description": "Laravel bridge for the Testo testing framework.",
    "license": "BSD-3-Clause",
    "type": "library",
    "keywords": [
        "testo",
        "laravel",
        "testing",
        "test"
    ],
    "authors": [
        {
            "name": "Ichi",
            "homepage": "https://github.com/ichinya"
        }
    ],
    "require": {
        "php": ">=8.2",
        "laravel/framework": "^12.0 || ^13.0",
        "testo/testo": "^0.10.45"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "ichinya/laratesto-rector": "@dev",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "2.6.2",
        "testo/bridge-mockery": "^0.1.0",
        "testo/bridge-rector": "^0.2.4"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/rector",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Laratesto\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laratesto\\Tests\\": "tests/",
            "Laratesto\\Rector\\Tests\\": "packages/rector/tests/",
            "App\\": "tests/Fixture/laravel/app/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Laratesto\\LaratestoServiceProvider"
            ]
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "testo run"
        ]
    }
}
