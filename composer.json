{
    "name": "ichinya/laratesto",
    "description": "Laravel bridge for the Testo testing framework.",
    "license": "BSD-3-Clause",
    "type": "library",
    "keywords": [
        "testo",
        "laravel",
        "testing",
        "test"
    ],
    "authors": [
        {
            "name": "Ichi",
            "homepage": "https://github.com/ichinya"
        }
    ],
    "require": {
        "php": ">=8.3",
        "laravel/framework": "^13.0",
        "testo/testo": "^0.10.55"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "ichinya/laratesto-rector": "dev-feat/rector-27-compatibility as 0.2.0",
        "rector/rector": "2.7.0",
        "testo/bridge-mockery": "^0.1.0",
        "testo/bridge-rector": "^0.3.3"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/ichinya/laratesto-rector"
        }
    ],
    "autoload": {
        "psr-4": {
            "Laratesto\\": "src/"
        },
        "files": [
            "src/Shim/PhpUnit/autoload.php"
        ],
        "classmap": [
            "src/Overrides/Testo/Bridge/Rector/Testing/Internal/RectorRunner.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Laratesto\\Tests\\": "tests/",
            "Laratesto\\Rector\\Tests\\": "tests/Rector/",
            "App\\": "tests/Fixture/laravel/app/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Laratesto\\LaratestoServiceProvider"
            ]
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "testo run"
        ]
    }
}
