{
    "name": "ichinya/laratesto",
    "description": "Laravel bridge for the Testo testing framework.",
    "license": "BSD-3-Clause",
    "type": "library",
    "keywords": [
        "testo",
        "laravel",
        "testing",
        "test"
    ],
    "authors": [
        {
            "name": "Ichi",
            "homepage": "https://github.com/ichinya"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "testo/testo": "^0.10.42"
    },
    "require-dev": {
        "testo/bridge-mockery": "^0.1.0"
    },
    "autoload": {
        "psr-4": {
            "Laratesto\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laratesto\\Tests\\": "tests/",
            "App\\": "tests/Fixture/laravel/app/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Laratesto\\LaratestoServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "testo run"
    }
}
